# Local development only. Add these as Environment Variables in Render instead.
DEBUG=True
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com
DATABASE_URL=postgresql://username:password@hostname:5432/database_name
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
# Set SERVE_MEDIA=True only when MEDIA_ROOT is backed by persistent storage.
SERVE_MEDIA=False
